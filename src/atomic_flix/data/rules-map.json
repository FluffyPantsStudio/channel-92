  {"id": "SP-GRAIN", "source": "process", "method": "auto", "check": "sent", "unit": "shot", "level": "block", "due": "v1", "says": "No grain, film-stock or texture word in any prompt that was sent to a model.", "words": "grain"},
  {"id": "SP-EQUIP", "source": "process", "method": "auto", "check": "sent", "unit": "shot", "level": "block", "due": "v1", "says": "No equipment noun (tripod, light stand, crew) in any prompt that was sent.", "words": "equipment"},
  {"id": "SP-NEVER", "source": "process", "method": "auto", "check": "sent", "unit": "shot", "level": "block", "due": "v1", "says": "Nothing on the film's never list in any prompt that was sent.", "words": "film.json never"},
  {"id": "SP-HANDS", "source": "process", "method": "auto", "check": "sent", "unit": "shot", "level": "block", "due": "v1", "says": "No hands, arms or fingers named in a sung take's prompt as sent.", "words": "hands"},
  {"id": "SP-PATHS", "source": "process", "method": "auto", "check": "sent", "unit": "shot", "level": "block", "due": "v1", "says": "Every job's inputs lie inside the film folder and its graph inside the film or the kit's graphs."},
  {"id": "LG-LOAD", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "spend", "says": "standing.json loads under the gate machine's own refusals (answers signed by a model, answers dated before their question, a reviewer used twice)."},
  {"id": "LG-ORDER", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "spend", "says": "Gates pass in order: each gate is asked only after the gate before it has a passing answer."},
  {"id": "LG-PERSON", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "spend", "says": "Every gate answer names a person (no model or agent word) and holds their own words."},
  {"id": "LG-ARRIVAL", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "warn", "due": "spend", "says": "Every gate answer says how it arrived: typed by the person, or relayed with their words quoted."},
  {"id": "LG-REUSE", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "spend", "says": "One answer is never reused for another gate (the same words recorded at the same moment)."},
  {"id": "LG-BATCH", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "v1", "says": "Every render was planned under a gate-5 yes, and no yes covers more takes than it approved."},
  {"id": "LG-JUDGE", "source": "process", "method": "ledger", "check": "ledger", "unit": "shot", "level": "block", "due": "v1", "says": "A judge looked at a shot's first frame (judge.at in stills/<key>.json) before its first render was sent."},
  {"id": "LG-ROUNDS", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "v1", "says": "Cold review rounds repeat until a round names no errors (or the rounds stall) before v1 is asked."},
  {"id": "LG-FRESH", "source": "process", "method": "ledger", "check": "ledger", "unit": "film", "level": "block", "due": "v1", "says": "Every review round's reviewer is new to the film."},
  {"id": "SC-MASTER", "source": "process", "method": "auto", "check": "scene", "unit": "scene", "level": "block", "due": "spend", "says": "Shots that share a scene share one master still, and every later still of the scene was made from it."},
  {"id": "SC-PROPS", "source": "process", "method": "auto", "check": "scene", "unit": "scene", "level": "block", "due": "spend", "says": "Shots that share a scene use the same reference for each prop."},
  {"id": "SC-ASPECT", "source": "process", "method": "auto", "check": "scene", "unit": "scene", "level": "block", "due": "spend", "says": "Shots that share a scene share one aspect ratio."},
  {"id": "SC-LOOK", "source": "process", "method": "auto", "check": "scene", "unit": "scene", "level": "warn", "due": "spend", "says": "Shots that share a scene share one look."},
  {"id": "CT-AUDIT", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "block", "due": "v1", "says": "The newest cut's audit has no errors (never slower than 1x, no hidden head frames shown, no jump cut)."},
  {"id": "CT-AUDIT-W", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "warn", "due": "v1", "says": "The newest cut's audit has no warnings (cuts on the one or three, no held note cut through)."},
  {"id": "CT-LOUD", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "warn", "due": "v1", "says": "The song is laid back with its peak at or under -1 dBFS and not quieter than -16 LUFS."},
  {"id": "CT-GRADE", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "block", "due": "v1", "says": "Nothing leaves ungraded: the newest cut has a graded version."},
  {"id": "CT-SPREAD", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "warn", "due": "v1", "says": "The grade narrows the spread of black, white and colour across shots; it never widens it."},
  {"id": "CT-GRAIN", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "block", "due": "v1", "says": "No grain is graded into the master."},
  {"id": "CT-FLASH", "source": "process", "method": "auto", "check": "cut", "unit": "film", "level": "block", "due": "v1", "says": "The graded film passes the flash check."},
  {"id": "PS-EAR", "source": "process", "method": "person", "check": null, "unit": "film", "level": "block", "due": "v1", "says": "Takes are picked by the person watching and listening, never from a description or a number.", "why": "only the person knows how they picked"},
  {"id": "PS-BAR1", "source": "process", "method": "person", "check": null, "unit": "film", "level": "block", "due": "spend", "says": "Bar one is decided by ear: the click is played to the person before gate 2.", "why": "the ledger holds the gate-2 words, not whether the click was heard"},
  {"id": "PS-WORDS", "source": "process", "method": "person", "check": null, "unit": "film", "level": "block", "due": "spend", "says": "Gate answers are the person's own words, never invented or paraphrased by whoever recorded them.", "why": "a relayed answer cannot prove its words were the person's (docs/gates.md)"},
  {"id": "PS-COLD", "source": "process", "method": "person", "check": null, "unit": "film", "level": "block", "due": "v1", "says": "Each cold reviewer had not read the prompts.", "why": "the ledger records the claim; only the driver knows what the reviewer was given"},
  {"id": "PS-AI", "source": "process", "method": "person", "check": null, "unit": "film", "level": "warn", "due": "v1", "says": "The release says plainly where the output is AI-made and follows every loaded model's licence.", "why": "the release text lives outside the film folder"},
  {"id": "GP-HEAVY", "source": "process", "method": null, "check": null, "unit": "film", "level": "block", "due": "v1", "says": "One heavy load at a time; never defeat the commit-headroom floor with a bigger batch or a second runner.", "why": "the runner enforces it while it runs, but nothing durable records headroom readings or other runner processes, so a film cannot be checked for it afterwards"},
  {"id": "GP-MINE", "source": "process", "method": null, "check": null, "unit": "film", "level": "block", "due": "v1", "says": "Never clear a ComfyUI queue, stop an instance that has work, or delete another job's files.", "why": "nothing records queue clears, restarts or deletions"}
 ]
}
